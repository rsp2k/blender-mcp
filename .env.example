# Template for runtime config. Copy to .env (gitignored) and fill in values.
# .env is gitignored — NEVER commit it.
#
# Phase G (current) supports two auth backends:
#   AUTH_BACKEND=authentik (default, production) — OIDC proxy to Authentik.
#                Requires the AUTHENTIK_* vars below. See docs/authentik-setup.md
#                for the one-time OAuth-app provisioning walkthrough.
#                In this mode OAUTH_SECRET_KEY + ADMIN_PASSWORD aren't used.
#   AUTH_BACKEND=inmemory (local dev + Gate H) — homegrown OAuth provider
#                against a tiny USERS dict built from ADMIN_PASSWORD (+ optional
#                DEMO_PASSWORD). OAUTH_SECRET_KEY is required for JWT signing.
#                Don't use in production.

# Required for AUTH_BACKEND=inmemory ONLY (left blank → fine if AUTH_BACKEND=authentik)
OAUTH_SECRET_KEY=
ADMIN_PASSWORD=

# Required always — public hostname for caddy-docker-proxy TLS termination
DOMAIN=mcp.blender.bet
# Optional — comma-separated extra hostnames to also serve. Each gets its
# own cert from Caddy. Useful for graceful URL renames (keep the old name
# alive while clients migrate). Leave blank or omit to serve DOMAIN only.
# DOMAIN_ALIASES=mcp.l.warehack.ing

# Auth backend selection (Phase G)
# - "authentik" (default): OIDC proxy to Authentik. Requires the AUTHENTIK_*
#   vars below + PUBLIC_BASE_URL. Production path.
# - "inmemory": BlenderMCPOAuthProvider against USERS dict. Local-dev only.
AUTH_BACKEND=authentik

# Authentik OIDC config. Provision a new OAuth2/OpenID provider + application
# in Authentik's admin UI; copy client_id + client_secret here. The config URL
# is per-app: https://<authentik-host>/application/o/<app-slug>/.well-known/openid-configuration
AUTHENTIK_CONFIG_URL=https://auth.new.l.supported.systems/application/o/blender-mcp/.well-known/openid-configuration
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Public base URL of THIS server (where OAuth callbacks land). Used by OIDCProxy
# to construct redirect URIs that match what's registered in Authentik.
PUBLIC_BASE_URL=https://mcp.blender.bet

# Compose project namespace — keeps containers/networks per-app and prevents
# DNS collisions on the shared caddy fabric (see CLAUDE.md, May-2026 burn)
COMPOSE_PROJECT_NAME=blender-mcp

# Optional — pass to enable the demo user (omit to disable)
# DEMO_PASSWORD=

# Optional — JWT lifetimes.
# Server-code defaults are 30/7, but compose overrides to 480/7 below so
# real Blender sessions don't expire mid-edit. The addon does NOT yet
# auto-refresh on 401; users have to re-click Login when the access token
# expires. 480 min (8h) is comfortable for a workday without leaving a
# JWT live for too long if it leaks.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional — server bind (defaults: 0.0.0.0:8000, which is what the
# Dockerfile EXPOSE + compose port mapping expect — don't change unless
# you also update the Dockerfile and compose port map)
# BLENDER_MCP_HOST=0.0.0.0
# BLENDER_MCP_PORT=8000
