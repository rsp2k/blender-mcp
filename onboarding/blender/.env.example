# Instance identity. COMPOSE_PROJECT_NAME namespaces the container and the config volume.
COMPOSE_PROJECT_NAME=blender-onboarding
INSTANCE=onboarding
INSTANCE_DIR=/home/rpm/claude/blender-mcp/onboarding/blender

# Published image; change BLENDER_VERSION to move this instance to another Blender.
BLENDER_IMAGE=git.supported.systems/rsp2k/blender-desktop
BLENDER_VERSION=5.2.2

# Web (noVNC) hostname served by caddy-docker-proxy on the shared caddy network.
DOMAIN=l.supported.systems
WEB_HOSTNAME=blender-onboarding.l.supported.systems

# Raw VNC endpoint on the host. Each instance needs its own VNC_PORT.
# Real passwords live only in .env (gitignored); `make info` prints them.
VNC_PASSWORD=CHANGEME
# Optional second password for watchers; their mouse and keyboard input is ignored.
VNC_VIEWONLY_PASSWORD=
VNC_BIND=127.0.0.1
VNC_PORT=5905
# Watch link: passwordless VNC and noVNC where all input is refused, for humans
# to follow along. On by default; 0 turns it off.
VNC_WATCH_ENABLED=1
VNC_WATCH_PORT=5910
WATCH_HOSTNAME=watch-blender-onboarding.l.supported.systems
VNC_GEOMETRY=1920x1080
# Desktop size is fixed so agent click coordinates stay valid across reconnects.
# Set VNC_ALLOW_RESIZE=1 and NOVNC_RESIZE=remote to let noVNC resize it instead.
VNC_ALLOW_RESIZE=0
NOVNC_RESIZE=scale
VNC_DEPTH=24

# 1 = viewport OpenGL on the NVIDIA GPU via VirtualGL, 0 = llvmpipe
GPU_VIEWPORT=1
NOVNC_ENABLED=1
BLENDER_RESTART=1
# Window manager: i3 (tiling, default) or openbox. I3_MOD: Mod4 = Super, Mod1 = Alt.
# I3_LAYOUT: default (side by side), tabbed or stacking.
WINDOW_MANAGER=i3
I3_MOD=Mod4
I3_LAYOUT=default
BLENDER_ARGS=
BLENDER_ONLINE_ACCESS=1
# 0 hides Blender's splash screen, which otherwise covers the viewport in VNC
BLENDER_SHOW_SPLASH=0
SHM_SIZE=2g
# CPU: frame cap for viewport readback and VNC, container core limit, and the
# watch server's share of one core. Idle cost is low either way; these bound
# what a constantly changing viewport can take.
BLENDER_MAX_FPS=24
BLENDER_CPUS=4
WATCH_MAX_CPU=15

# Extensions installed and enabled on first boot (state persists in the config volume).
# Repos: "id=https://host/index.json id2=..."; packages: "repo_id.package_id ...".
BLENDER_EXTENSION_REPOS=
BLENDER_EXTENSIONS=
