---
/**
 * /login-complete: landing page the Blender addon redirects to after a
 * successful OAuth flow against the MCP server.
 *
 * Not gated by forward_auth (see the @protected matcher in
 * docker-compose.yml), so it must not render X-Authentik-* headers: on
 * an ungated route those come from the client, not from Authentik.
 *
 * Addon-side context (server URL, client_id, addon version, timestamp)
 * arrives via query string: non-secret values, OK to render directly.
 * No tokens or auth codes are passed through URLs anywhere. Every value
 * is optional; without any, the details disclosure is left out.
 */
import ClipHero from '../components/ClipHero.astro';
import '../styles/login-complete.css';

const params = Astro.url.searchParams;
const ctx = {
  server: params.get('server') ?? '',
  client_id: params.get('client_id') ?? '',
  ver: params.get('ver') ?? '',
  ts: params.get('ts') ?? '',
};
const hasDetails = Object.values(ctx).some(Boolean);
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Signed in to BlenderMCP</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="preload" as="image" href="/img/mascot/clip-512.png" />
    <link rel="prefetch" href="/img/mascot/clip-sheet.webp" />
  </head>
  <body>
    <main class="lc">
      <ClipHero
        class="lc-clip"
        name="B. Clip"
        caption={"B. Clip says hi.\nSee you in Blender!"}
      />

      <div class="lc-body">
        <p class="lc-status">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          Login complete
        </p>
        <h1>You're signed in. Go back to Blender.</h1>
        <p class="lede">
          Everything else happens in Blender now, so you can close this tab.
        </p>

        <div
          class="bpanel"
          role="img"
          aria-label="What the BlenderMCP tab in Blender's sidebar looks like now: the Blender MCP panel reads Connected, Personal, and the Chat panel below it has a box for typing a request."
        >
          <div class="bpanel-head" aria-hidden="true">
            <svg class="bpanel-chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
            <span>Blender MCP</span>
            {ctx.ver && <span class="bpanel-ver">{ctx.ver}</span>}
          </div>
          <div class="bpanel-row bpanel-connected" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
            <span>Connected &middot; Personal</span>
            <span class="bpanel-badge">1</span>
          </div>
          <div class="bpanel-head bpanel-sub" aria-hidden="true">
            <svg class="bpanel-chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
            <span>Chat</span>
          </div>
          <div class="bpanel-row bpanel-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
            <span>Ask for something in this scene.</span>
          </div>
          <div class="bpanel-row bpanel-input" aria-hidden="true">
            <span class="bpanel-field">Put a 2 m cube on the table<span class="bpanel-caret"></span></span>
            <span class="bpanel-badge">2</span>
          </div>
        </div>

        <ol class="lc-steps">
          <li>
            <strong>Check that it reads Connected.</strong>
            Look at the top of the BlenderMCP tab in the 3D Viewport sidebar.
            Press <kbd>N</kbd> over the viewport if the sidebar is hidden.
          </li>
          <li>
            <strong>Ask for something.</strong>
            Type a request in the Chat panel just below and press
            <kbd>Enter</kbd>. New accounts start with a free trial.
          </li>
        </ol>

        <ul class="lc-links">
          <li>
            <a href="https://docs.blender.bet/tutorials/quickstart/">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></svg>
              Quickstart
            </a>
          </li>
          <li>
            <a href="https://docs.blender.bet/how-to/chat-in-blender/">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
              Chat inside Blender
            </a>
          </li>
        </ul>

        {hasDetails && (
          <details class="lc-details">
            <summary>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              Connection details
            </summary>
            <p class="lc-details-note">
              For troubleshooting. Nothing here is secret, so it is fine to
              paste into a support request.
            </p>
            <dl>
              {ctx.server && (<><dt>Server</dt><dd>{ctx.server}</dd></>)}
              {ctx.ver && (<><dt>Add-on</dt><dd>BlenderMCP {ctx.ver}</dd></>)}
              {ctx.client_id && (<><dt>Client ID</dt><dd>{ctx.client_id}</dd></>)}
              {ctx.ts && (<><dt>Time</dt><dd><time datetime={ctx.ts}>{ctx.ts}</time></dd></>)}
            </dl>
            <p class="lc-details-proto">
              OAuth 2.1 with PKCE, native-app flow (RFC 8252), signed in through
              <a href="https://auth.supported.systems">Authentik</a>.
            </p>
          </details>
        )}
      </div>
    </main>
  </body>
</html>
