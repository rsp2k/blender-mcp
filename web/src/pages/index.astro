---
/**
 * blender.bet apex — landing. Prerendered (static, cache-friendly).
 *
 * Job: say what BlenderMCP is, show the Chat panel it adds to Blender, then
 * walk a first-time user through installing the add-on. Reference material lives on docs.blender.bet.
 *
 * Future authenticated user surfaces (dashboard, account, etc.) would
 * live at sibling routes like /account, /dashboard — gated by Caddy's
 * forward_auth + read identity from X-Authentik-* headers.
 */
import ChatShowcase from '../components/ChatShowcase.astro';
import ClipHero from '../components/ClipHero.astro';
import InstallWalkthrough from '../components/InstallWalkthrough.astro';
import '../styles/home.css';
import JointBadge from '../components/JointBadge.astro';
import MeetBLink from '../components/MeetBLink.astro';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BlenderMCP</title>
    <meta
      name="description"
      content="Ask Claude for changes from Blender's sidebar, or connect any MCP client to the Blender you're running. Install the add-on from mcp.blender.bet/install in about two minutes."
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="preload" as="image" href="/img/mascot/clip-512.png" />
    <link rel="prefetch" href="/img/mascot/clip-sheet.webp" />
  </head>
  <body>
    <div class="page">
      <main class="hero">
        <ClipHero />
        <div class="hero-text">
        <MeetBLink />
        <h1>BlenderMCP</h1>
        <p class="tag">
          Ask Claude for changes from Blender's own sidebar, or connect any
          MCP client to the Blender you're running. Either way it reads your
          scene, builds and edits objects, and asks before running code.
          Several clients and people can share one scene.
        </p>
        <div class="ctas">
          <a class="cta primary" href="#install">Install the add-on</a>
          <a class="cta" href="https://docs.blender.bet/">Read the docs</a>
          <a class="cta" href="https://docs.blender.bet/explanation/use-cases/">Use cases</a>
        </div>
        </div>
      </main>

      <ChatShowcase />

      <InstallWalkthrough />

      <p class="foot">
        Your Blender answers only to you, the clients you sign in, and the
        people you invite to share a scene.<br />
        <a href="https://github.com/rsp2k/blender-mcp">Source on GitHub</a> &middot;
        MCP server at <a href="https://mcp.blender.bet/">mcp.blender.bet</a>
      </p>
    </div>
    <JointBadge />
  </body>
</html>
