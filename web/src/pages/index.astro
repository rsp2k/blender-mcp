---
/**
 * blender.bet apex — landing. Prerendered (static, cache-friendly).
 *
 * Job: say what BlenderMCP is, then walk a first-time user through
 * installing the add-on. Reference material lives on docs.blender.bet.
 *
 * Future authenticated user surfaces (dashboard, account, etc.) would
 * live at sibling routes like /account, /dashboard — gated by Caddy's
 * forward_auth + read identity from X-Authentik-* headers.
 */
import InstallWalkthrough from '../components/InstallWalkthrough.astro';
import '../styles/home.css';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BlenderMCP</title>
    <meta
      name="description"
      content="Connect Claude or any MCP client to the Blender you're running. Install the add-on from mcp.blender.bet/install in about two minutes."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/img/mascot/clip-512.png" />
  </head>
  <body>
    <div class="page">
      <main class="hero">
        <figure class="mascot">
          <img src="/img/mascot/clip-512.png" width="512" height="512"
               alt="Clip, a dark blue steel binder clip with big eyes and a small smile, its two wire handles raised like arms." />
          <figcaption>
            Meet Clip, the assistant inside your Blender.
            <small>Binder clip model by
              <a href="https://www.cgtrader.com/designers/teen-wolf">teen-wolf</a> on CGTrader.</small>
          </figcaption>
        </figure>
        <div class="hero-text">
        <h1>BlenderMCP</h1>
        <p class="tag">
          Connect Claude, or any MCP client, to the Blender you're running.
          It reads the scene, builds and edits objects, and asks before
          running code. Several clients and people can share one scene.
        </p>
        <div class="ctas">
          <a class="cta primary" href="#install">Install the add-on</a>
          <a class="cta" href="https://docs.blender.bet/">Read the docs</a>
          <a class="cta" href="https://docs.blender.bet/explanation/use-cases/">Use cases</a>
        </div>
        </div>
      </main>

      <InstallWalkthrough />

      <p class="foot">
        MCP-spec OAuth 2.1 + PKCE &middot; Authentik-backed SSO &middot;
        <a href="https://github.com/rsp2k/blender-mcp">GitHub</a><br />
        MCP server: <a href="https://mcp.blender.bet/">mcp.blender.bet</a>
      </p>
    </div>
  </body>
</html>
