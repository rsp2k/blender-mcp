---
/**
 * blender.bet apex — minimal landing. Prerendered (static, cache-friendly).
 *
 * Job: tell a visitor what BlenderMCP is in two sentences and point them
 * at the docs. The "real" content lives on docs.blender.bet (Starlight)
 * and the install path on github.com/rsp2k/blender-mcp.
 *
 * Future authenticated user surfaces (dashboard, account, etc.) would
 * live at sibling routes like /account, /dashboard — gated by Caddy's
 * forward_auth + read identity from X-Authentik-* headers.
 */
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BlenderMCP</title>
    <meta
      name="description"
      content="A Model Context Protocol server that lets multiple LLM clients collaborate on shared Blender 3D instances over an OAuth-isolated message bus."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0e1116;
        --surface: #161b22;
        --border: #2a313a;
        --text: #d4d4d4;
        --muted: #8b949e;
        --accent: #2bb3a4;
        --accent-glow: rgba(43, 179, 164, 0.18);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh;
        font-family: system-ui, -apple-system, sans-serif;
        background:
          radial-gradient(circle at 20% 0%, var(--accent-glow), transparent 50%),
          radial-gradient(circle at 80% 100%, var(--accent-glow), transparent 50%),
          var(--bg);
        color: var(--text); line-height: 1.5;
        display: grid; place-items: center; padding: 2em 1em;
      }
      main {
        max-width: 640px; width: 100%; text-align: center;
      }
      h1 { font-size: 3em; font-weight: 700; margin: 0 0 .3em; color: var(--accent); }
      .tag { color: var(--muted); margin: 0 0 2.5em; font-size: 1.15em; line-height: 1.5; }
      .ctas { display: flex; flex-wrap: wrap; gap: 1em; justify-content: center; margin-bottom: 2em; }
      a.cta {
        display: inline-block; padding: .9em 1.6em;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 8px; color: var(--text); text-decoration: none;
        font-weight: 500;
        transition: border-color .15s, transform .1s;
      }
      a.cta.primary { background: var(--accent); color: #08221f; border-color: var(--accent); font-weight: 600; }
      a.cta:hover { border-color: var(--accent); transform: translateY(-1px); }
      .foot { color: #6e7681; font-size: .85em; margin-top: 2em; }
      .foot a { color: #8b949e; }
    </style>
  </head>
  <body>
    <main>
      <h1>BlenderMCP</h1>
      <p class="tag">
        A Model Context Protocol server that lets multiple LLM clients
        collaborate on shared Blender 3D instances over an OAuth-isolated
        message bus.
      </p>
      <div class="ctas">
        <a class="cta primary" href="https://docs.blender.bet/">Read the docs</a>
        <a class="cta" href="https://github.com/rsp2k/blender-mcp">GitHub</a>
        <a class="cta" href="https://docs.blender.bet/tutorials/quickstart/">Quickstart</a>
      </div>
      <p class="foot">
        MCP-spec OAuth 2.1 + PKCE &middot; Authentik-backed SSO<br />
        MCP server: <a href="https://mcp.blender.bet/">mcp.blender.bet</a>
      </p>
    </main>
  </body>
</html>
