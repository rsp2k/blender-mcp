# Copy to .env and adjust before `docker compose up`.

# Compose project namespace — keeps containers/networks scoped per-app.
COMPOSE_PROJECT_NAME=blender-mcp-web

# Public hostname for caddy-docker-proxy TLS termination.
DOMAIN=blender.bet
# Optional — comma-separated extra hostnames to also serve. Each gets
# its own cert from Caddy. Use during URL renames so old links keep
# working while users migrate.
# DOMAIN_ALIASES=

# Astro site URL (used for canonical links + sitemap).
SITE_URL=https://blender.bet

# ---- Phase I8: shared Postgres for /buses pages ----
# Same DATABASE_URL the MCP server uses. Connects to the postgres
# container in the blender-mcp compose stack via the joined internal
# network (see docker-compose.yml networks block). Read-only access;
# mutations happen through the addon + REST API on mcp.blender.bet.
#
# The host part is the postgres container's name on the MCP stack —
# defaults to ``blender-mcp-server-postgres`` which is what the MCP
# stack creates when COMPOSE_PROJECT_NAME=blender-mcp-server (the
# prod default). If your MCP stack uses a different project name,
# update the host accordingly + also set MCP_INTERNAL_NETWORK below.
DATABASE_URL=postgresql://blender_mcp:CHANGEME@blender-mcp-server-postgres:5432/blender_mcp

# Override the external network name web/ joins to reach the MCP
# stack's internal network. Defaults to ``blender-mcp-server_internal``.
# MCP_INTERNAL_NETWORK=blender-mcp-server_internal

# ---- Web BFF OAuth (web/ is an OAuth client of mcp.blender.bet) ----
# Generate this once and KEEP IT — rotating invalidates every existing
# session cookie. 32 random bytes = 64 hex chars.
#   openssl rand -hex 32
SESSION_COOKIE_KEY=

# Where the MCP server lives. /oauth/start redirects users to
# $MCP_SERVER_URL/authorize; /oauth/callback exchanges codes against
# $MCP_SERVER_URL/token. Must match the MCP server's public URL exactly
# — Authentik validates redirect_uri against the registered value (which
# is derived from SITE_URL above).
MCP_SERVER_URL=https://mcp.blender.bet
