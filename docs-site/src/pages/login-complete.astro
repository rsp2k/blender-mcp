---
/**
 * /login-complete — landing page the Blender addon redirects to after a
 * successful OAuth flow.
 *
 * Receives the addon's *non-secret* context via query string:
 *   ?server=https://mcp.blender.bet&client_id=<uuid>&ver=1.4.0&ts=2026-05-27%2013:55:12
 *
 * No tokens, no auth codes — those exist only long enough for the
 * token-exchange step on the addon side and don't belong in any URL the
 * browser persists. User identity (welcome-by-name) is intentionally
 * NOT shown here because the Authentik session cookie is scoped to
 * auth.supported.systems and won't reach blender.bet without a separate
 * SSO setup (deferred).
 *
 * This is a standalone Astro page (NOT inside the Starlight docs frame)
 * so it can present as a celebratory landing instead of a docs chapter.
 */
import { Icon } from 'astro-icon/components';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BlenderMCP login complete</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0e1116;
        --surface: #161b22;
        --border: #2a313a;
        --text: #d4d4d4;
        --muted: #8b949e;
        --dim: #6e7681;
        --accent: #2bb3a4;
        --accent-glow: rgba(43, 179, 164, 0.15);
        --success: #5fb878;
        --mono: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background:
          radial-gradient(circle at 20% 0%, var(--accent-glow), transparent 50%),
          radial-gradient(circle at 80% 100%, var(--accent-glow), transparent 50%),
          var(--bg);
        color: var(--text);
        display: grid;
        place-items: center;
        padding: 2em 1em;
      }
      main {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 2.5em;
        max-width: 640px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
      }
      .check {
        width: 64px;
        height: 64px;
        margin: 0 auto 1em;
        display: grid;
        place-items: center;
        background: var(--accent-glow);
        border: 2px solid var(--success);
        border-radius: 50%;
        color: var(--success);
      }
      h1 {
        margin: 0 0 0.4em;
        font-size: 1.8em;
        font-weight: 600;
        text-align: center;
        color: var(--success);
      }
      .lede {
        text-align: center;
        margin: 0 0 2em;
        color: var(--muted);
        font-size: 1.05em;
        line-height: 1.5;
      }
      dl.context {
        margin: 0 0 2em;
        padding: 1.2em 1.5em;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-family: var(--mono);
        font-size: 0.88em;
        display: grid;
        grid-template-columns: max-content 1fr;
        column-gap: 1.5em;
        row-gap: 0.5em;
        align-items: baseline;
      }
      dl.context dt {
        color: var(--muted);
        font-weight: 400;
        white-space: nowrap;
      }
      dl.context dd {
        margin: 0;
        color: var(--text);
        word-break: break-all;
      }
      .next-h {
        margin: 0 0 0.8em;
        font-size: 1em;
        font-weight: 600;
        color: var(--text);
      }
      .next-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.6em;
      }
      .next-list a {
        display: flex;
        align-items: center;
        gap: 0.8em;
        padding: 0.9em 1.1em;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        text-decoration: none;
        transition:
          border-color 0.15s,
          transform 0.1s;
      }
      .next-list a:hover {
        border-color: var(--accent);
        transform: translateX(2px);
      }
      .next-list a svg {
        width: 20px;
        height: 20px;
        color: var(--accent);
        flex-shrink: 0;
      }
      .next-list small {
        display: block;
        color: var(--muted);
        font-size: 0.85em;
        margin-top: 0.1em;
      }
      footer {
        margin-top: 2em;
        padding-top: 1.2em;
        border-top: 1px solid var(--border);
        text-align: center;
        font-size: 0.8em;
        color: var(--dim);
        line-height: 1.6;
      }
      footer code {
        background: var(--bg);
        color: var(--muted);
        padding: 1px 6px;
        border-radius: 3px;
        font-family: var(--mono);
        font-size: 0.85em;
      }
      footer a {
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="check">
        <Icon name="lucide:check" width="34" height="34" />
      </div>
      <h1>Login complete</h1>
      <p class="lede">
        Your BlenderMCP addon is authorized. You can close this tab and return to Blender.
      </p>

      <dl class="context" id="context">
        <!-- Populated by client-side JS from URL query params.
             Server-rendered placeholders (visible if JS disabled). -->
        <dt>Server</dt><dd id="ctx-server">—</dd>
        <dt>Addon</dt><dd id="ctx-ver">—</dd>
        <dt>Client&nbsp;ID</dt><dd id="ctx-cid">—</dd>
        <dt>Issued at</dt><dd id="ctx-ts">—</dd>
      </dl>

      <p class="next-h">What's next?</p>
      <ul class="next-list">
        <li>
          <a href="/tutorials/quickstart/">
            <Icon name="lucide:compass" />
            <div>
              Quickstart
              <small>Connect your first MCP client + dispatch a script</small>
            </div>
          </a>
        </li>
        <li>
          <a href="/reference/tools/">
            <Icon name="lucide:book-open" />
            <div>
              Tool reference
              <small>All 24+ blender_* tools, with examples</small>
            </div>
          </a>
        </li>
        <li>
          <a href="/explanation/architecture/">
            <Icon name="lucide:workflow" />
            <div>
              How it works
              <small>The bus, role attribution, OAuth flow</small>
            </div>
          </a>
        </li>
      </ul>

      <footer>
        MCP-spec OAuth 2.1 + PKCE &middot; RFC 8252 native-app flow<br />
        Authenticated via <a href="https://auth.supported.systems">Authentik</a>
        through FastMCP <code>OIDCProxy</code>
      </footer>
    </main>

    <script>
      // Hydrate context from URL params. All non-secret — no tokens, no codes.
      // Done client-side because this is a static Astro page (no SSR), and
      // the addon context isn't in any cookie the browser carries here.
      const p = new URLSearchParams(window.location.search);
      const fill = (id: string, val: string | null) => {
        if (val) document.getElementById(id)!.textContent = val;
      };
      fill('ctx-server', p.get('server'));
      fill('ctx-ver', p.get('ver') ? `BlenderMCP v${p.get('ver')}` : null);
      fill('ctx-cid', p.get('client_id'));
      fill('ctx-ts', p.get('ts'));
    </script>
  </body>
</html>
