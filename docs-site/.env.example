# Copy to .env and adjust before `make prod` / `make dev`.

# Compose project namespace — keeps containers/networks scoped per-app.
COMPOSE_PROJECT_NAME=blender-mcp-docs

# Public hostname the host Caddy will terminate TLS on.
# DNS-01 cert issuance happens via the rfc2136_local snippet — see
# `caddy.tls.import` labels in docker-compose.yml.
DOMAIN=blender-mcp.l.warehack.ing

# `prod` runs the static-build stack via `make prod`.
# `dev`  runs the Astro HMR stack via `make dev`.
MODE=prod
